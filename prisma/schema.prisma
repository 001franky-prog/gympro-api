generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["app", "platform"]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model branches {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String             @db.Uuid
  branch_code      String             @db.VarChar(30)
  branch_name      String             @db.VarChar(200)
  address          String?
  phone            String?            @db.VarChar(30)
  status           String             @default("active") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_branches_tenant")
  members          members[]
  plan_prices      plan_prices[]
  role_assignments role_assignments[]

  @@unique([tenant_id, branch_code], map: "uq_branches_tenant_code")
  @@unique([tenant_id, id], map: "uq_branches_tenant_id")
  @@index([tenant_id], map: "idx_branches_tenant_id")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model permissions {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  permission_code  String?            @unique(map: "uq_permissions_code") @default(dbgenerated("(((((module_code)::text || '.'::text) || (resource_code)::text) || '.'::text) || (action_code)::text)")) @db.VarChar(150)
  module_code      String             @db.VarChar(50)
  resource_code    String             @db.VarChar(50)
  action_code      String             @db.VarChar(50)
  description      String?
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model role_assignments {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String             @db.Uuid
  membership_id      String             @db.Uuid
  role_id            String             @db.Uuid
  scope_type         String             @db.VarChar(20)
  branch_id          String?            @db.Uuid
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  branches           branches?          @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onUpdate: NoAction, map: "fk_assignment_branch")
  tenant_memberships tenant_memberships @relation(fields: [tenant_id, membership_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_assignment_membership")
  roles              roles              @relation(fields: [tenant_id, role_id], references: [tenant_id, id], onUpdate: NoAction, map: "fk_assignment_role")

  @@unique([tenant_id, membership_id, role_id, scope_type, branch_id], map: "uq_role_assignment")
  @@index([tenant_id, branch_id], map: "idx_assignments_branch", where: raw("(branch_id IS NOT NULL)"))
  @@index([tenant_id, membership_id], map: "idx_assignments_membership")
  @@index([tenant_id, role_id], map: "idx_assignments_role")
  @@schema("app")
}

model role_permissions {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String      @db.Uuid
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  permissions   permissions @relation(fields: [permission_id], references: [id], onUpdate: NoAction, map: "fk_role_permissions_permission")
  roles         roles       @relation(fields: [tenant_id, role_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role")

  @@unique([tenant_id, role_id, permission_id], map: "uq_role_permissions_assignment")
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model roles {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String             @db.Uuid
  role_code        String             @db.VarChar(50)
  role_name        String             @db.VarChar(100)
  description      String?
  is_system_role   Boolean            @default(false)
  status           String             @default("active") @db.VarChar(20)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_assignments role_assignments[]
  role_permissions role_permissions[]
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_roles_tenant")

  @@unique([tenant_id, role_code], map: "uq_roles_tenant_code")
  @@unique([tenant_id, id], map: "uq_roles_tenant_id")
  @@index([tenant_id], map: "idx_roles_tenant_id")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenant_memberships {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String             @db.Uuid
  user_id          String             @db.Uuid
  status           String             @default("invited") @db.VarChar(20)
  joined_at        DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_assignments role_assignments[]
  tenants          tenants            @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_membership_tenant")
  users            users              @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_membership_user")

  @@unique([tenant_id, id], map: "uq_membership_tenant_id")
  @@unique([tenant_id, user_id], map: "uq_membership_tenant_user")
  @@index([user_id], map: "idx_memberships_user_id")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String               @db.VarChar(255)
  password_hash      String?
  full_name          String               @db.VarChar(200)
  phone              String?              @db.VarChar(30)
  status             String               @default("pending") @db.VarChar(20)
  email_verified_at  DateTime?            @db.Timestamptz(6)
  last_login_at      DateTime?            @db.Timestamptz(6)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  tenant_memberships tenant_memberships[]

  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenants {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_code        String               @unique @db.VarChar(30)
  tenant_name        String               @db.VarChar(200)
  tenant_type        String               @default("independent") @db.VarChar(20)
  contact_email      String?              @db.VarChar(255)
  status             String               @default("pending") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  branches           branches[]
  members            members[]
  membership_plans   membership_plans[]
  roles              roles[]
  tenant_memberships tenant_memberships[]

  @@schema("platform")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String    @db.Uuid
  branch_id     String?   @db.Uuid
  member_number String    @default(dbgenerated("('GP-'::text || lpad((nextval('app.member_number_seq'::regclass))::text, 10, '0'::text))")) @db.VarChar(32)
  full_name     String    @db.VarChar(150)
  phone         String?   @db.VarChar(20)
  email         String?   @db.VarChar(254)
  status        String    @default("pending") @db.VarChar(20)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  branches      branches? @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onUpdate: NoAction, map: "fk_members_branch")
  tenants       tenants   @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_members_tenant")

  @@unique([tenant_id, id], map: "uq_members_tenant_id")
  @@unique([tenant_id, member_number], map: "uq_members_tenant_number")
  @@index([tenant_id, branch_id], map: "idx_members_tenant_branch")
  @@index([tenant_id, created_at(sort: Desc)], map: "idx_members_tenant_created")
  @@index([tenant_id, full_name], map: "idx_members_tenant_name")
  @@index([tenant_id, status], map: "idx_members_tenant_status")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model membership_plans {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String       @db.Uuid
  plan_code            String       @db.VarChar(32)
  plan_name            String       @db.VarChar(150)
  description          String?
  terms_and_conditions String?
  duration_value       Int
  duration_unit        String       @db.VarChar(10)
  status               String       @default("draft") @db.VarChar(20)
  created_at           DateTime     @default(now()) @db.Timestamptz(6)
  updated_at           DateTime     @default(now()) @db.Timestamptz(6)
  tenants              tenants      @relation(fields: [tenant_id], references: [id], onUpdate: NoAction, map: "fk_membership_plans_tenant")
  plan_prices          plan_prices?

  @@unique([tenant_id, plan_code], map: "uq_membership_plans_tenant_code")
  @@unique([tenant_id, id], map: "uq_membership_plans_tenant_id")
  @@index([tenant_id, status], map: "idx_membership_plans_tenant_status")
  @@schema("app")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model plan_prices {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String           @db.Uuid
  plan_id          String           @db.Uuid
  branch_id        String?          @db.Uuid
  price_amount     Decimal          @db.Decimal(14, 2)
  currency_code    String           @default("MMK") @db.VarChar(3)
  status           String           @default("inactive") @db.VarChar(20)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @db.Timestamptz(6)
  branches         branches?        @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onUpdate: NoAction, map: "fk_plan_prices_branch")
  membership_plans membership_plans @relation(fields: [tenant_id, plan_id], references: [tenant_id, id], onUpdate: NoAction, map: "fk_plan_prices_plan")

  @@unique([tenant_id, plan_id, branch_id], map: "uq_plan_prices_active_branch", where: raw("((branch_id IS NOT NULL) AND ((status)::text = 'active'::text))"))
  @@unique([tenant_id, plan_id], map: "uq_plan_prices_active_general", where: raw("((branch_id IS NULL) AND ((status)::text = 'active'::text))"))
  @@unique([tenant_id, id], map: "uq_plan_prices_tenant_id")
  @@index([tenant_id, branch_id], map: "idx_plan_prices_tenant_branch")
  @@index([tenant_id, plan_id], map: "idx_plan_prices_tenant_plan")
  @@schema("app")
}
